# Django core. DEBUG defaults to False; local development sets it to True.
# SECRET_KEY is required whenever DEBUG is off (generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))")
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Required when DEBUG is off. Comma-separate keys to rotate (first encrypts):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Production only: https origins allowed to log into the Django admin/dashboard.
CSRF_TRUSTED_ORIGINS=
# Where payment proofs are stored; must NOT be served by nginx. Default: ./private_media
PRIVATE_MEDIA_ROOT=

# Email for password reset (DEBUG prints to console). Any SMTP provider works.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Admart <no-reply@yourdomain.com>

# Frontend base URL (OAuth callbacks redirect back here)
FRONTEND_URL=http://localhost:5173

# Google / YouTube OAuth
# Same web client id as the frontend VITE_GOOGLE_CLIENT_ID.
# Used for Google Sign-In (POST /api/auth/google) AND YouTube social connect.
# Authorized redirect URIs in Google Cloud must include:
#   http://localhost:5173/auth-callback
#   http://localhost:8000/api/social/callback/youtube
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/callback/youtube

# Meta OAuth — Facebook Login uses META_APP_*; Instagram Business Login uses
# INSTAGRAM_APP_* (App Dashboard → Instagram → API setup with Instagram login).
# If INSTAGRAM_APP_* is empty, the backend falls back to META_APP_*.
# Add this redirect URI in Instagram business login settings (not Facebook Login):
#   http://localhost:8000/api/social/callback/instagram
META_APP_ID=
META_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/callback/facebook
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/callback/instagram

# Publishing scopes are "Invalid Scopes" until added on the Meta app.
# Facebook Page post: add pages_show_list, pages_read_engagement, pages_manage_posts
# (Standard Access is enough for app roles in Development), set True, reconnect Facebook.
# Keep False until those permissions are on the app, otherwise Connect fails.
FACEBOOK_PUBLISH_ENABLED=False
# Instagram feed/Reels: add instagram_business_content_publish on Instagram login,
# set True, reconnect a Professional account. Media URL must be publicly fetchable.
INSTAGRAM_PUBLISH_ENABLED=False

# TikTok Login Kit. Redirect URI MUST be https — TikTok rejects http://localhost.
# Local: ngrok http 8000, then paste:
#   https://<ngrok-host>/api/social/callback/tiktok
# Add that same URI under Login Kit in the TikTok developer portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=
TIKTOK_PUBLISH_ENABLED=False

# Snapchat Login Kit — identity only (no Snap publish). Redirect URI in Snap Kit:
#   http://localhost:8000/api/social/callback/snapchat
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/callback/snapchat

# Ads Manager OAuth (separate from organic Connect).
# Current Admart Meta app (Facebook Login + App Ads Manager) cannot add Marketing API.
# Create a new Business app with use case "Create & manage ads with Marketing API",
# then set META_ADS_APP_ID / META_ADS_APP_SECRET. Leave META_APP_* for Facebook Login.
# Redirect URI on that new app:
#   http://localhost:8000/api/ads/callback/meta
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_OAUTH_REDIRECT_URI=http://localhost:8000/api/ads/callback/meta
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
TIKTOK_ADS_OAUTH_REDIRECT_URI=http://localhost:8000/api/ads/callback/tiktok
SNAP_ADS_CLIENT_ID=
SNAP_ADS_CLIENT_SECRET=
SNAP_ADS_OAUTH_REDIRECT_URI=http://localhost:8000/api/ads/callback/snap

# YouTube ads = Google Ads (not the YouTube Data API). Same GOOGLE_OAUTH_CLIENT_*
# as YouTube Connect. Add this redirect in Google Cloud:
#   http://localhost:8000/api/ads/callback/google
# Enable Google Ads API + paste developer token from ads.google.com API Center.
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:8000/api/ads/callback/google
GOOGLE_ADS_DEVELOPER_TOKEN=

# Fernet key for encrypting stored social tokens (optional in dev; required in prod)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Image generation provider key (server-side only — never put this in the frontend)
FAL_KEY=
# Optional: public base URL for /media uploads so the provider can fetch them (e.g. https://abc.ngrok.io)
MEDIA_BASE_URL=

# Prompt enhancer (server-side only)
GEMINI_API_KEY=
PROMPT_ENHANCER_MODEL=gemini-2.5-flash-lite
PROMPT_ENHANCER_TIMEOUT=20

# Optional owned template preview generation (server-side only)
RUNWARE_API_KEY=
RUNWARE_API_URL=https://api.runware.ai/v1
# Pick a Runware image model id before running: python manage.py seed_templates --generate-previews
RUNWARE_PREVIEW_MODEL=
RUNWARE_TIMEOUT=60
DGX_IMAGE_API_URL=http://100.104.174.12:8002
# Backward-compatible fallback if DGX_IMAGE_API_URL is not set:
# DGX_FLUX_API_URL=http://100.104.174.12:8002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DGX_START_TIMEOUT=120
DGX_REQUEST_TIMEOUT=260
DGX_POLL_INTERVAL=2
DGX_POLL_TIMEOUT=1200

# Auto-refresh the template gallery every N minutes (0 = disabled). Default: 30.
TEMPLATE_AUTO_REFRESH_MINUTES=30
